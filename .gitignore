# Data — regenerate with the pipeline scripts, never commit
data/raw/
data/*.log
data/interim/
data/processed/
*.parquet
*.pkl
# The released model ships with the repo: CI has no training data, so
# without it the GitHub Action would silently score with the baseline.
# (gitignore has no inline comments — this must stay on its own line.)
!models/*.pkl

# Secrets
.env

# Python
__pycache__/
*.py[cod]
.venv/
venv/
*.egg-info/
.pytest_cache/
.ruff_cache/
.coverage
htmlcov/

# Notebooks
.ipynb_checkpoints/

# OS
.DS_Store

# Workflow files are kept on disk but not committed: the gh OAuth token lacks
# the `workflow` scope, so any push containing them is rejected outright. Add
# them through the GitHub web UI, or once you have the scope:
#   gh auth login --scopes "repo,workflow" --hostname github.com --web
# then delete these two lines and commit .github/workflows/ normally.
.github/workflows/
